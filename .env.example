# คีย์ Google AI Studio (ฟรี) จาก https://aistudio.google.com/apikey  ← ค่าเริ่มต้นใช้ Gemini
GEMINI_API_KEY=
# คีย์สำรอง (คนละบัญชี Google) ใช้เมื่อคีย์หลักโควตาเต็ม
GEMINI_API_KEY_2=

# คีย์ Claude API (เสียเงิน) จาก https://platform.claude.com/ — ใส่เฉพาะถ้าจะเลือกโมเดล Claude
ANTHROPIC_API_KEY=

# ผู้ดูแลระบบคนแรกของหลังบ้าน (สร้างครั้งแรกที่เปิดโปรแกรม)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# คีย์สำหรับเข้ารหัสเซสชัน Telegram และคุกกี้ (เว้นว่าง = สร้างให้อัตโนมัติใน data/secret.key)
SECRET_KEY=

HOST=127.0.0.1
PORT=8000
DISPLAY_TZ_OFFSET=7
# LINE Messaging API (แจ้งเตือน + กดอนุมัติจาก LINE) — ไม่บังคับ
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LINE Chat Bot สำหรับลูกค้า (OA คนละตัวกับด้านบน) — ไม่บังคับ · Webhook: <เว็บ>/linebot/webhook
LINE_BOT_CHANNEL_ACCESS_TOKEN=
LINE_BOT_CHANNEL_SECRET=